rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    match /staff/{staffId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'high');
    }
    match /training/{trainingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'high');
    }
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'high');
    }
    match /competencies/{compId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'high' || request.auth.token.role == 'medium');
    }
    match /evaluations/{evalId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'high' || request.auth.token.role == 'medium');
    }
    match /nurseData/{nurseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'high');
    }
    match /documents/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'high');
    }
    match /menuPermissions/{menuId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}